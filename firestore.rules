rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD — PORRA UDLP 26/27
// ============================================================================
// Principios:
// 1. Nadie puede tocar su propio saldo directamente. Solo Cloud Functions.
// 2. Un jugador solo ve/edita sus propios pronósticos.
// 3. Jornadas y configuración global: lectura libre, escritura solo admin.
// 4. El admin general se identifica por un documento en /admins/{uid}.
// 5. La colección /pines es pública (necesaria antes del login).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── PINES — público (lectura/escritura necesaria antes del login) ────
    // El hash del PIN nunca sale en claro del dispositivo del usuario.
    match /pines/{nombre} {
      allow read, write: if true;
    }

    // ── CREDENCIALES PIN (legacy Cloud Function) ─────────────────────────
    match /credenciales_pin/{uid} {
      allow read, write: if false; // Solo Admin SDK
    }

    // ── ADMINS ───────────────────────────────────────────────────────────
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if false; // Solo Admin SDK o consola Firebase
    }

    // ── LIGAS ────────────────────────────────────────────────────────────
    match /ligas/{ligaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.creadorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── JORNADAS ─────────────────────────────────────────────────────────
    match /jornadas/{jornadaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── PRONÓSTICOS ──────────────────────────────────────────────────────
    match /pronosticos/{jornadaId} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ── CLASIFICACIÓN ────────────────────────────────────────────────────
    match /clasificacion/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
      match /{document=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ── CLASIFICACIÓN ESTRELLAS ──────────────────────────────────────────
    match /clasificacion_estrellas/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── EL OTRO ──────────────────────────────────────────────────────────
    match /elOtro/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── MIS 5 ESTRELLAS ──────────────────────────────────────────────────
    match /estrellas_seleccion/{jornadaId} {
      allow read, write: if isSignedIn();
      match /jugadores/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── RESULTADOS DE ESTRELLAS POR JORNADA ──────────────────────────────
    match /estrellas_resultados/{jornadaId} {
      allow read, write: if isSignedIn();
      match /jugadores/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── PERFILES DE JUGADOR ──────────────────────────────────────────────
    match /perfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── FOTOS DE JUGADORES DE LA PLANTILLA (verificadas por admin) ───────
    match /fotosJugadores/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── PAGOS ────────────────────────────────────────────────────────────
    match /pagos/{pagoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── PREMIOS DE JORNADA (confirmación de cobros) ──────────────────────
    match /premios_jornada/{jornadaId} {
      allow read, write: if isSignedIn();
      match /usuarios/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── CIERRES DE JORNADA (pantalla de una sola visualización) ──────────
    match /cierres_jornada/{jornadaId} {
      allow read, write: if isSignedIn();
      match /usuarios/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── EL OTRO — VACANTES ───────────────────────────────────────────────
    match /elOtroVacantes/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── SALDOS — INTOCABLE POR EL CLIENTE ───────────────────────────────
    match /saldos/{ligaId} {
      allow read: if isSignedIn();
      allow write: if false; // Solo Cloud Functions (Admin SDK)
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── COMPROBANTES DE PAGO ────────────────────────────────────────────
    match /comprobantes_pago/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.estado == 'pendiente';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── REGISTRO DE AUDITORÍA ────────────────────────────────────────────
    match /auditoria_pagos/{registroId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Cloud Functions
    }

    // ── FANTASY ──────────────────────────────────────────────────────────
    match /fantasy_clasificacion/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /fantasy_elecciones/{jornadaId} {
      allow read, write: if isSignedIn();
      match /jugadores/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    match /fantasy_plantilla/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── PORRA ANUAL 26/27 ────────────────────────────────────────────────
    match /porraAnual2627/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── RIFAS Y PAPELETAS ────────────────────────────────────────────────
    match /rifas/{rifaId} {
      allow read: if true;
      allow write: if isSignedIn();
      match /papeletas/{numero} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ── BOLSAS — saldo interno por jugador (devoluciones de rifa, abonos
    //    del admin, pago de jornadas) con historial de movimientos ───────
    match /bolsas/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
      match /movimientos/{movId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ── REPARTO CREADORES ────────────────────────────────────────────────
    match /reparto_creadores/{ligaId} {
      allow read: if isSignedIn();
      allow write: if false; // Solo Cloud Functions
      match /creadores/{creadorId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── PREINSCRIPCIONES ─────────────────────────────────────────────────
    match /preinscripciones/{docId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── CONFIGURACIÓN GLOBAL ─────────────────────────────────────────────
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── NOTIFICACIONES ───────────────────────────────────────────────────
    match /notification_tokens/{token} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── COLECCIONES LEGADAS 25/26 (solo lectura) ─────────────────────────
    match /porraAnualPronosticos/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /apuestasExtra/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /activity_log/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── REGLA DE CIERRE ──────────────────────────────────────────────────
    // Cualquier colección no contemplada arriba requiere autenticación.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
